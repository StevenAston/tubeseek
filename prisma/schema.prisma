generator client {
	provider = "prisma-client"
	output   = "../src/generated/client"
}

datasource db {
	provider = "sqlite"
}

model Channel {
	id        String   @id @default(uuid())
	youtubeId String   @unique // UC… id; RSS feed is youtube.com/feeds/videos.xml?channel_id=<this>
	title     String
	url       String
	approved  Boolean  @default(false)
	videos    Video[]
	createdAt DateTime @default(now())
}

model Video {
	id           String    @id @default(uuid())
	youtubeId    String    @unique
	title        String
	duration     Int?      // seconds
	uploadDate   String?   // yt-dlp YYYYMMDD, absent in flat listings
	channelTitle String?
	channelId    String?
	channel      Channel?  @relation(fields: [channelId], references: [id], onDelete: Cascade)
	isSingle     Boolean   @default(false) // added by its own URL rather than via a channel
	approval     String    @default("UNRATED") // UNRATED, APPROVED, REJECTED — rejections are kept as negative labels
	transcript       String?
	transcriptSource String? // null = not fetched; CAPTIONS | WHISPER = done; NONE = no captions, Whisper not queued yet; WHISPER_PENDING = queued in paudio; FAILED = paudio errored
	createdAt    DateTime  @default(now())
}

// ponytail: grows forever; prune old rows if it ever gets big
model Log {
	id        Int      @id @default(autoincrement())
	createdAt DateTime @default(now())
	level     String   // INFO, WARN, ERROR
	youtubeId String?
	message   String
}
